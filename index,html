<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Smart Nazorat 2.0</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #f2f2f7;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 16px;
        }
        .card {
            background: #ffffff;
            border-radius: 20px;
            padding: 24px;
            width: 100%;
            max-width: 360px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
            text-align: center;
        }
        h2 { font-size: 22px; color: #1c1c1e; margin-bottom: 6px; }
        p { font-size: 14px; color: #8e8e93; margin-bottom: 20px; }
        .input-group {
            margin-bottom: 14px;
            text-align: left;
        }
        label {
            font-size: 12px;
            color: #6c6c70;
            font-weight: 600;
            margin-bottom: 4px;
            display: block;
            text-transform: uppercase;
        }
        input {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #e5e5ea;
            border-radius: 10px;
            font-size: 16px;
            outline: none;
            background: #fafafa;
        }
        input:focus { border-color: #007aff; background: #fff; }
        button {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            color: #ffffff;
            margin-top: 10px;
            cursor: pointer;
        }
        .btn-in { background-color: #34c759; }
        .btn-out { background-color: #ff3b30; }
        #msg { font-size: 13px; color: #ff3b30; margin-top: 10px; }
    </style>
</head>
<body>

<div class="card">
    <h2>Smart Nazorat 2.0</h2>
    <p>Tizimga kirish uchun Login va Parolingizni kiriting:</p>

    <div class="input-group">
        <label>Login</label>
        <input type="text" id="username" placeholder="Loginni kiriting">
    </div>

    <div class="input-group">
        <label>Parol</label>
        <input type="password" id="password" placeholder="Parolni kiriting">
    </div>

    <button id="submit-btn">Tasdiqlash</button>
    <div id="msg"></div>
</div>

<script>
    const tg = window.Telegram.WebApp;
    tg.ready();
    tg.expand();

    const urlParams = new URLSearchParams(window.location.search);
    const actionType = urlParams.get('action') || 'in';

    const btn = document.getElementById('submit-btn');
    const usernameInput = document.getElementById('username');
    const passwordInput = document.getElementById('password');
    const msg = document.getElementById('msg');

    if (actionType === 'in') {
        btn.innerText = "🟢 TASDIQLASH (Keldim)";
        btn.className = "btn-in";
    } else {
        btn.innerText = "🔴 TASDIQLASH (Ketdim)";
        btn.className = "btn-out";
    }

    btn.onclick = () => {
        const username = usernameInput.value.trim();
        const password = passwordInput.value.trim();

        if (!username || !password) {
            msg.innerText = "Iltimos, login va parolni to'liq kiriting!";
            return;
        }

        btn.disabled = true;
        btn.innerText = "⏳ Geolokatsiya aniqlanmoqda...";

        // Geolokatsiyani olish
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                (position) => {
                    sendData(username, password, position.coords.latitude, position.coords.longitude);
                },
                (error) => {
                    // Geolokatsiya berilmagan taqdirda ham davom ettirish
                    sendData(username, password, null, null);
                },
                { enableHighAccuracy: true, timeout: 5000 }
            );
        } else {
            sendData(username, password, null, null);
        }
    };

    function sendData(username, password, lat, lon) {
        btn.innerText = "⏳ Yuborilmoqda...";
        const payload = {
            action: actionType === 'in' ? 'checked_in' : 'checked_out',
            username: username,
            password: password,
            lat: lat,
            lon: lon
        };
        tg.sendData(JSON.stringify(payload));
        tg.close();
    }
</script>

</body>
</html>
